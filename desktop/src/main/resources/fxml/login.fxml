<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="vn.edu.wallet.desktop.LoginController" styleClass="auth-background">
  <children>
    <HBox maxWidth="1000" maxHeight="570" styleClass="auth-panel">
      <children>
        <VBox prefWidth="480" spacing="22" styleClass="auth-hero">
          <padding><Insets top="58" right="48" bottom="58" left="48"/></padding>
          <children>
            <Label text="BANKINGAPP  /  VÍ NỘI BỘ" styleClass="eyebrow"/>
            <Label text="Tài chính rõ ràng.&#10;Giao dịch an tâm." wrapText="true" styleClass="hero-title"/>
            <Label text="Chuyển tiền nội bộ, theo dõi số dư và xem sao kê trong một không gian làm việc gọn gàng." wrapText="true" styleClass="hero-copy"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Bảo mật phiên đăng nhập • Số tiền nguyên đồng VND" wrapText="true" styleClass="hero-foot"/>
          </children>
        </VBox>
        <VBox prefWidth="520" spacing="13" styleClass="auth-form">
          <padding><Insets top="45" right="58" bottom="45" left="58"/></padding>
          <children>
            <Label fx:id="formTitle" styleClass="form-title"/>
            <Label text="Kết nối server" styleClass="field-label"/>
            <TextField fx:id="serverUrl" promptText="http://localhost:8080/api/v1"/>
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="email" promptText="ban@example.com"/>
            <VBox fx:id="registerFields" spacing="10">
              <children><Label text="Tên hiển thị" styleClass="field-label"/><TextField fx:id="displayName" promptText="Nguyễn An"/></children>
            </VBox>
            <Label text="Mật khẩu" styleClass="field-label"/>
            <PasswordField fx:id="password" promptText="Ít nhất 10 ký tự" onAction="#submit"/>
            <Label fx:id="status" wrapText="true" minHeight="38" styleClass="status-text"/>
            <Button fx:id="submitButton" onAction="#submit" maxWidth="Infinity" styleClass="primary-button"/>
            <Button fx:id="switchButton" onAction="#switchMode" maxWidth="Infinity" styleClass="link-button"/>
          </children>
        </VBox>
      </children>
    </HBox>
  </children>
</StackPane>
