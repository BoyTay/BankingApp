<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="vn.edu.wallet.desktop.WorkspaceController" styleClass="app-root">
  <left>
    <VBox prefWidth="230" spacing="5" styleClass="sidebar">
      <padding><Insets top="28" right="16" bottom="22" left="16"/></padding>
      <children>
        <Label text="BANKINGAPP" styleClass="brand"/>
        <Label text="VÍ NỘI BỘ" styleClass="side-caption"/>
        <Region prefHeight="24"/>
        <Button text="Tổng quan" onAction="#showDashboard" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Chuyển tiền" onAction="#showTransfer" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Lịch sử" onAction="#showHistory" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Sao kê chuyển tiền" onAction="#showStatements" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Nhập chi tiêu CSV" onAction="#showImports" maxWidth="Infinity" styleClass="nav-button"/>
        <Button text="Thống kê chi tiêu" onAction="#showStats" maxWidth="Infinity" styleClass="nav-button"/>
        <Button fx:id="adminNav" text="Cấp số dư thử nghiệm" onAction="#showAdmin" maxWidth="Infinity" styleClass="nav-button"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Label fx:id="userLabel" wrapText="true" styleClass="side-user"/>
        <Button text="Đăng xuất" onAction="#logout" maxWidth="Infinity" styleClass="nav-button"/>
      </children>
    </VBox>
  </left>
  <center>
    <VBox spacing="0">
      <children>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
          <padding><Insets top="14" right="30" bottom="14" left="30"/></padding>
          <children>
            <Label text="Không gian ví" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="connectionLabel" text="Đang kết nối" styleClass="connection-pill"/>
          </children>
        </HBox>
        <Label fx:id="globalStatus" minHeight="34" wrapText="true" styleClass="global-status"/>
        <StackPane VBox.vgrow="ALWAYS" styleClass="content-stack">
          <children>
            <ScrollPane fx:id="dashboardScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="dashboardPage" spacing="22" styleClass="page">
                  <children>
                    <Label text="Tổng quan ví" styleClass="page-title"/>
                    <Label text="Theo dõi số dư và hoạt động gần đây của bạn." styleClass="page-subtitle"/>
                    <VBox spacing="12" styleClass="balance-card">
                      <children><Label text="SỐ DƯ HIỆN TẠI" styleClass="balance-caption"/><Label fx:id="balanceLabel" text="—" styleClass="balance-number"/><Label fx:id="walletCodeLabel" text="Mã ví: —" styleClass="wallet-code"/></children>
                    </VBox>
                    <HBox spacing="12"><children><Button text="Làm mới" onAction="#loadDashboard" styleClass="secondary-button"/><Button text="Chuyển tiền ngay" onAction="#showTransfer" styleClass="primary-button"/></children></HBox>
                    <Label text="Giao dịch gần đây" styleClass="section-title"/>
                    <Label fx:id="recentEmptyLabel" text="Chưa có giao dịch nào." visible="false" managed="false" maxWidth="Infinity" styleClass="empty-state"/>
                    <ListView fx:id="recentList" prefHeight="250" styleClass="data-list"/>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="transferScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="transferPage" spacing="17" styleClass="page">
                  <children>
                    <Label text="Chuyển tiền" styleClass="page-title"/>
                    <Label text="Tra cứu người nhận, kiểm tra thông tin và xác nhận trước khi gửi." styleClass="page-subtitle"/>
                    <VBox spacing="13" styleClass="form-card">
                      <children>
                        <Label text="Mã ví người nhận" styleClass="field-label"/>
                        <HBox spacing="10"><children><TextField fx:id="recipientCode" promptText="WLT..." HBox.hgrow="ALWAYS"/><Button fx:id="lookupButton" text="Tra cứu" onAction="#lookupRecipient" styleClass="secondary-button"/></children></HBox>
                        <Label fx:id="recipientResult" text="Chưa tra cứu" wrapText="true" styleClass="hint-text"/>
                        <Label text="Số tiền (VND nguyên đồng)" styleClass="field-label"/>
                        <TextField fx:id="transferAmount" promptText="Ví dụ: 125000"/>
                        <Button fx:id="confirmTransferButton" text="Xem xác nhận" onAction="#confirmTransfer" styleClass="primary-button"/>
                        <HBox spacing="10"><children><Button fx:id="retryTransferButton" text="Thử lại yêu cầu cũ" onAction="#retryTransfer" visible="false" managed="false" styleClass="secondary-button"/><Button fx:id="newTransferButton" text="Giao dịch mới" onAction="#newTransfer" visible="false" managed="false" styleClass="secondary-button"/></children></HBox>
                        <Label fx:id="transferStatus" wrapText="true" styleClass="status-text"/>
                      </children>
                    </VBox>
                    <VBox fx:id="receiptCard" spacing="8" visible="false" managed="false" styleClass="form-card">
                      <children><Label text="Biên nhận giao dịch" styleClass="section-title"/><Label fx:id="receiptText" wrapText="true" styleClass="receipt-text"/></children>
                    </VBox>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="historyScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="historyPage" spacing="16" styleClass="page">
                  <children>
                    <Label text="Lịch sử giao dịch" styleClass="page-title"/>
                    <Label text="Chỉ các giao dịch gửi hoặc nhận của ví này." styleClass="page-subtitle"/>
                    <ListView fx:id="historyList" prefHeight="390" styleClass="data-list"/>
                    <HBox spacing="10" alignment="CENTER_LEFT"><children><Button fx:id="previousPageButton" text="Trang trước" onAction="#previousHistory" styleClass="secondary-button"/><Label fx:id="historyPageLabel" text="Trang 1" styleClass="hint-text"/><Button fx:id="nextPageButton" text="Trang sau" onAction="#nextHistory" styleClass="secondary-button"/><Button text="Xem chi tiết" onAction="#viewTransferDetail" styleClass="primary-button"/></children></HBox>
                    <Label fx:id="detailText" wrapText="true" styleClass="receipt-text"/>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="statementsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="statementsPage" spacing="18" styleClass="page">
                  <children>
                    <Label text="Sao kê chuyển tiền" styleClass="page-title"/>
                    <Label text="Chọn khoảng ngày UTC tối đa 366 ngày. Tệp chỉ chứa giao dịch của ví này." wrapText="true" styleClass="page-subtitle"/>
                    <VBox spacing="12" styleClass="form-card">
                      <children>
                        <Label text="Từ ngày" styleClass="field-label"/><DatePicker fx:id="statementFrom"/>
                        <Label text="Đến ngày" styleClass="field-label"/><DatePicker fx:id="statementTo"/>
                        <HBox spacing="10"><children><Button fx:id="csvButton" text="Tải CSV" onAction="#downloadCsv" styleClass="primary-button"/><Button fx:id="pdfButton" text="Tải PDF" onAction="#downloadPdf" styleClass="secondary-button"/></children></HBox>
                        <Label fx:id="statementStatus" wrapText="true" styleClass="status-text"/>
                      </children>
                    </VBox>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="importsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="importsPage" spacing="18" styleClass="page">
                  <children>
                    <Label text="Nhập chi tiêu CSV" styleClass="page-title"/>
                    <Label text="Dữ liệu nhập dùng để thống kê, không thay đổi số dư ví." styleClass="page-subtitle"/>
                    <VBox spacing="12" styleClass="form-card">
                      <children>
                        <Label text="Định dạng mẫu" styleClass="field-label"/>
                        <ComboBox fx:id="importFormat" prefWidth="260"/>
                        <HBox spacing="10"><children><Button text="Chọn tệp CSV" onAction="#chooseImportFile" styleClass="secondary-button"/><Label fx:id="selectedFileLabel" text="Chưa chọn tệp" styleClass="hint-text"/></children></HBox>
                        <Button fx:id="importButton" text="Nhập dữ liệu" onAction="#uploadImport" styleClass="primary-button"/>
                        <Label fx:id="importStatus" wrapText="true" styleClass="status-text"/>
                      </children>
                    </VBox>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="statsScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="statsPage" spacing="18" styleClass="page">
                  <children>
                    <Label text="Thống kê chi tiêu" styleClass="page-title"/>
                    <Label text="Tổng hợp các khoản chi đã nhập từ CSV." styleClass="page-subtitle"/>
                    <HBox spacing="10" alignment="CENTER_LEFT"><children><Label text="Từ" styleClass="field-label"/><DatePicker fx:id="statsFrom"/><Label text="Đến" styleClass="field-label"/><DatePicker fx:id="statsTo"/></children></HBox>
                    <HBox spacing="10"><children><Button text="Theo danh mục" onAction="#statsByCategory" styleClass="secondary-button"/><Button text="Theo tháng" onAction="#statsByMonth" styleClass="secondary-button"/></children></HBox>
                    <VBox spacing="10" styleClass="form-card"><children><Label fx:id="statsTotal" text="Chưa có thống kê" styleClass="section-title"/><ListView fx:id="statsList" prefHeight="320" styleClass="data-list"/><Label fx:id="statsStatus" wrapText="true" styleClass="status-text"/></children></VBox>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
            <ScrollPane fx:id="adminScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
              <content>
                <VBox fx:id="adminPage" spacing="18" styleClass="page">
                  <children>
                    <Label text="Cấp số dư thử nghiệm" styleClass="page-title"/>
                    <Label text="Chỉ dành cho ADMIN. Mỗi lần gửi tạo một khoản cấp tiền và bút toán audit." wrapText="true" styleClass="page-subtitle"/>
                    <VBox spacing="12" styleClass="form-card">
                      <children>
                        <Label text="Mã ví nhận" styleClass="field-label"/><TextField fx:id="grantWallet" promptText="WLT..."/>
                        <Label text="Số tiền VND" styleClass="field-label"/><TextField fx:id="grantAmount" promptText="Ví dụ: 1000000"/>
                        <Label text="Lý do" styleClass="field-label"/><TextArea fx:id="grantReason" promptText="Lý do cấp số dư" prefRowCount="3"/>
                        <HBox spacing="10"><children><Button fx:id="grantButton" text="Xác nhận cấp tiền" onAction="#grantBalance" styleClass="primary-button"/><Button fx:id="retryGrantButton" text="Thử lại yêu cầu cấp tiền cũ" onAction="#retryGrant" visible="false" managed="false" styleClass="secondary-button"/></children></HBox>
                        <Label fx:id="grantStatus" wrapText="true" styleClass="status-text"/>
                      </children>
                    </VBox>
                  </children>
                </VBox>
              </content>
            </ScrollPane>
          </children>
        </StackPane>
      </children>
    </VBox>
  </center>
</BorderPane>
