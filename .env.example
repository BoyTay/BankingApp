# Copy to .env and replace the password before starting Compose.
DB_PASSWORD=
# Optional host port for the API (default: 8080).
API_PORT=8080

# Optional: set both values to create an admin account on first startup.
# The admin password must contain at least 10 characters.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Fee engine runs daily in UTC. It creates and collects due fees without blocking login.
ACCOUNT_FEES_ENABLED=true
CHECKING_MONTHLY_FEE_DONG=5000
CREDIT_ANNUAL_FEE_DONG=20000

# Illustrative savings product: 90 days, 4.00% annual interest.
SAVINGS_TERM_DAYS=90
SAVINGS_ANNUAL_RATE_BPS=400
